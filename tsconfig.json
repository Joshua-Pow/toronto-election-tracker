{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "lib": ["ES2022"]
  },
  "include": ["worker/**/*.ts", "vite.config.mts", "worker-configuration.d.ts"]
}
